<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="neonGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF007F" />
      <stop offset="50%" stop-color="#EB1355" />
      <stop offset="100%" stop-color="#7928CA" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- Background circle with dark neon styling -->
  <rect width="64" height="64" rx="16" fill="#0F172A" />
  <circle cx="32" cy="32" r="26" fill="url(#neonGlow)" opacity="0.2" />
  <circle cx="32" cy="32" r="22" stroke="url(#neonGlow)" stroke-width="2.5" fill="none" filter="url(#glow)" />
  <!-- Running figure / Lightning Glow icon -->
  <path d="M34 14 L24 34 L31 34 L28 50 L42 28 L35 28 Z" fill="#FF007F" filter="url(#glow)" />
  <path d="M34 14 L24 34 L31 34 L28 50 L42 28 L35 28 Z" fill="#FFE500" />
</svg>
